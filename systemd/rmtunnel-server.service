[Unit]
Description=rmtunnel server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rmtunnel server /etc/rmtunnel/server.toml
Restart=on-failure
RestartSec=2
# The process itself already reconnects and fails over between disguise
# profiles — this restart is only for the case of the process itself dying
# (a panic, an OOM kill), not for ordinary tunnel disconnects.
LimitNOFILE=1048576
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
